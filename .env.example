# Copy this to .env.local and fill in the values

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: supabase.com > your project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Admin PIN ─────────────────────────────────────────────────────────────────
# 1. Pick a 4-digit PIN your group will use (e.g. 1234)
# 2. Pick a random salt string (any random characters)
# 3. Generate the hash by running:
#    node -e "const c=require('crypto');console.log(c.createHash('sha256').update('YOUR_PIN'+'YOUR_SALT').digest('hex'))"
# 4. Paste the output as ADMIN_PIN_HASH

PIN_SALT=change-me-to-any-random-string-16-chars
ADMIN_PIN_HASH=your-sha256-hash-here

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
